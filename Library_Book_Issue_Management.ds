 application "Library Book Issue Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Book_Issue_Request_Form
		{
			displayname = "Book Issue Request Form"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Email_Address
			(
    			type = email
				displayname = "Email Address"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Member_Name
			(
    			type = name
				displayname = "Member Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Hostel_Residential_Address
			(
    			type = address
				displayname = "Hostel Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Purpose_Of_Borrowing
			(
    			type = textarea
				displayname = "Purpose Of Borrowing"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Register_Roll_Number
			(
    			type = text
				displayname = "Register Roll Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Issue_Date
			(
    			type = date
				displayname = "Preferred Issue Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Number_Of_Copies
			(
				type = number
				displayname = "Number Of Copies"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Book_Category
			(
				type = picklist
				displayname = "Book Category"
				maxchar = 100
				values = {"Choice 2","Choice 3","Computer Science & Engineering","Electronics & Communication","Mechanical Engineering","Management & Commerce","General Literature","Rare/ReferenceOnly"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Member_Type
			(
				type = radiobuttons
				displayname = "Member Type"
				maxchar = 100
				values = {"Choice 2","Choice 3","Student","Faculty","Staff"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Due_Date
			(
    			type = date
				displayname = "Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Books_Returned
			(
    			type = checkbox
				displayname = "Books Returned"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Status
			(
				type = picklist
				displayname = "Issue Status"
				maxchar = 100
				values = {"Requested","Pending Approval","Approved","Issued","Returned","Overdue"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Collection_Time
			(
    			type = time
				displayname = "Preferred Collection Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Subject_Areas_Of_Interest
			(
				type = list	
				displayname = "Subject Areas Of Interest"
				values = {"Artificial Intelligence","Data Science","Machine Learning","Software Engineering","Electronics","Management"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Agree_To_Library_Rules
			(
				type = checkboxes	
				displayname = "Agree To Library Rules"
				values = {"I agree to the library rules and return policy"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Ebook_Reference_URL
			(
    			type = url
				displayname = "Ebook Reference URL"
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			Book_Cover_Image
			(
    			type = image
				displayname = "Book Cover Image"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Late_Fee_Waiver_Percent
			(
    			type = percentage
				displayname = "Late Fee Waiver Percent"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Fine_Amount_Due
			(
				displayname = "Fine Amount Due"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Book_Replacement_Price
			(
				type = decimal
				displayname = "Book Replacement Price"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Request_Submitted_On
			(
    			type = datetime
				displayname = "Request Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Member_Digital_Signature
			(
    			type = signature
				displayname = "Member Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Faculty_Recommendation_Upload
			(
    			type = upload file
				displayname = "Faculty Recommendation Upload"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Special_Request_Voice_Note
			(
     			type = audio
				displayname = "Special Request Voice Note"
    			duration=60
	 			row = 1
	 			column = 1   
				width = medium
			)
			Book_Review_Video
			(
    			type = video
				displayname = "Book Review Video"
    			duration=45
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Request_ID
			(
    			type = autonumber
				displayname = "Issue Request ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Fine_Payable
			(
				type = decimal
				displayname = "Total Fine Payable"
	 			row = 1
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Fine_Amount_Due - input.Fine_Amount_Due * input.Late_Fee_Waiver_Percent / 100
    						visibility = true
    			)
			)
			Book_Issue_QR_Code
			(
				type = qrcode
				displayname = "Book Issue QR Code"
				value = "${Issue_Request_ID}"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Requires_Home_Delivery
			(
    			type = checkbox
				displayname = "Requires Home Delivery"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Library_Rules_Display
			(
    			type = richtext
				displayname = "Library Rules Display"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
